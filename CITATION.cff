    affiliation: "Universidade Católica Dom Bosco"
  - family-names: "Bezerra"
    given-names: "Allan Rios"
    affiliation: "Universidade Católica Dom Bosco"
repository-code: "https://github.com/Magnumja/SARMOV"
keywords:
  - visão computacional
  - visão monocular
  - câmera de smartphone
  - estimativa de distância
  - assistência ao motorista
  - YOLOv8
